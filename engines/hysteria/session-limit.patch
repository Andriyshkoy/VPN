+}
+
+func TestSessionLimitNativeParallelAdmissionRace(t *testing.T) {
+	f := newNativeFixture(t, &nativePolicyAuth{})
+	const contenders = 24
+	start := make(chan struct{})
+	type attempt struct {
+		c   client.Client
+		err error
+	}
+	results := make(chan attempt, contenders)
+	for i := 0; i < contenders; i++ {
+		go func() {
+			<-start
+			c, err := f.connect("basic")
+			results <- attempt{c, err}
+		}()
+	}
+	close(start)
+	var winners []client.Client
+	for i := 0; i < contenders; i++ {
+		select {
+		case result := <-results:
+			if result.err == nil {
+				winners = append(winners, result.c)
+			}
+		case <-time.After(10 * time.Second):
+			t.Fatal("parallel admission attempt stalled")
+		}
+	}
+	defer func() {
+		for _, c := range winners {
+			_ = c.Close()
+		}
+	}()
+	if len(winners) != 1 {
+		t.Fatalf("max_sessions=1 admitted %d simultaneous clients, want exactly 1", len(winners))
+	}
+	if err := nativeEcho(winners[0], nativeEchoOrigin(t), []byte("winner stays connected")); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestSessionLimitNativeDeniedAuthDoesNotConsumeSlot(t *testing.T) {
+	f := newNativeFixture(t, &nativePolicyAuth{})
