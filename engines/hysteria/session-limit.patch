diff --git a/core/server/session_limit.go b/core/server/session_limit.go
new file mode 100644
index 0000000..274d7ef
--- /dev/null
+++ b/core/server/session_limit.go
@@ -0,0 +1,69 @@
+package server
+
+import (
+	"sync"
+
+	"github.com/apernet/quic-go"
+)
+
+// sessionRegistry is owned by one server instance. Counts include unlimited
+// connections so a newly constrained admission cannot ignore existing sessions.
+// Revoke generations are retained until restart to fence stale auth callbacks.
+type sessionRegistry struct {
+	mu       sync.Mutex
+	seq      uint64
+	closedAt map[string]uint64
+	active   map[string]map[*quic.Conn]struct{}
+}
+
+func newSessionRegistry() *sessionRegistry {
+	return &sessionRegistry{closedAt: make(map[string]uint64), active: make(map[string]map[*quic.Conn]struct{})}
+}
+
+func (s *sessionRegistry) generation() uint64 {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.seq
+}
+
+func (s *sessionRegistry) reserve(id string, conn *quic.Conn, max int, started uint64) (func(), bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closedAt[id] > started || (max > 0 && len(s.active[id]) >= max) {
+		return nil, false
+	}
+	if s.active[id] == nil {
+		s.active[id] = make(map[*quic.Conn]struct{})
+	}
+	s.active[id][conn] = struct{}{}
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			s.mu.Lock()
+			defer s.mu.Unlock()
+			delete(s.active[id], conn)
+			if len(s.active[id]) == 0 {
+				delete(s.active, id)
+			}
+		})
+	}, true
+}
+
+func (s *sessionRegistry) close(ids []string) int {
+	s.mu.Lock()
+	s.seq++
+	conns := make(map[*quic.Conn]struct{})
+	for _, id := range ids {
+		s.closedAt[id] = s.seq
+		for conn := range s.active[id] {
+			conns[conn] = struct{}{}
+		}
+	}
+	s.mu.Unlock()
+	// Do not release reservations here: the connection lifecycle owns its lease.
+	// CloseWithError ends the actual connection before finish can free the slot.
+	for conn := range conns {
+		_ = conn.CloseWithError(closeErrCodeTrafficLimitReached, "credential revoked")
+	}
+	return len(conns)
+}
