+package auth
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"math/big"
+	"net"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/apernet/hysteria/core/v2/client"
+	"github.com/apernet/hysteria/core/v2/server"
+	"github.com/apernet/hysteria/extras/v2/trafficlogger"
+)
+
+// The CI harness sets this URL to the real Python runtime and disposable MongoDB.
+// No deployed server or credential is accepted by this native integration test.
+func TestHTTPSessionLimitRuntimeMongoNative(t *testing.T) {
+	endpoint := os.Getenv("HYS_NATIVE_AUTH_URL")
+	if endpoint == "" {
+		t.Skip("HYS_NATIVE_AUTH_URL absent: disposable Mongo/runtime fixture not running")
+	}
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Scheme != "http" || u.Hostname() != "127.0.0.1" {
+		t.Fatal("fixture auth URL must be HTTP loopback")
+	}
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	stats := trafficlogger.NewTrafficStatsServer("native-fixture-secret")
+	statsHTTP := httptest.NewServer(stats)
+	defer statsHTTP.Close()
+	srv, err := server.NewServer(&server.Config{Conn: pc, TLSConfig: server.TLSConfig{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}}, Authenticator: NewHTTPAuthenticator(endpoint, false), TrafficLogger: stats, DisableUDP: true})
+	if err != nil {
+		_ = pc.Close()
+		t.Fatal(err)
+	}
+	engineReady := os.Getenv("HYS_NATIVE_ENGINE_READY")
+	if engineReady == "" {
+		_ = srv.Close()
+		t.Fatal("HYS_NATIVE_ENGINE_READY required for actual runtime capability check")
+	}
+	metadata, _ := json.Marshal(map[string]string{"stats_url": statsHTTP.URL, "stats_secret": "native-fixture-secret"})
+	if err := os.WriteFile(engineReady, metadata, 0600); err != nil {
+		_ = srv.Close()
+		t.Fatal(err)
+	}
+	defer os.Remove(engineReady)
+	go func() { _ = srv.Serve() }()
+	defer srv.Close()
+	connect := func(credential string) (client.Client, error) {
+		c, _, err := client.NewClient(&client.Config{ServerAddr: pc.LocalAddr(), Auth: credential, TLSConfig: client.TLSConfig{InsecureSkipVerify: true}})
+		return c, err
+	}
+	first, err := connect("native_limited:fixture-password")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	if second, err := connect("native_limited:fixture-password"); err == nil {
+		second.Close()
+		t.Fatal("Mongo BSON max_sessions=1 admitted a second native QUIC client")
+	}
+	for _, credential := range []string{"native_unlimited:fixture-password", "native_unlimited:fixture-password", "native_other:fixture-password"} {
+		c, err := connect(credential)
+		if err != nil {
+			t.Fatalf("%s: %v", credential, err)
+		}
+		defer c.Close()
+	}
+	_ = first.Close()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		c, err := connect("native_limited:fixture-password")
+		if err == nil {
+			_ = c.Close()
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("Mongo/runtime/native client slot was not released after disconnect")
+}
