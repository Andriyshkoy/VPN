# The node agent is private and serves local transport operations only.
# Central customer data, payments and tariffs belong to the platform backend.
VPN_CONTROL_DB=/var/lib/vpn-control/control.sqlite3
VPN_CONTROL_HYS_SOCKET=/run/vpn-control-hys/bridge.sock
VPN_CONTROL_NODE_ID=nl-1
VPN_CONTROL_COUNTRY=NL
VPN_CONTROL_PUBLIC_HOST=195.133.195.40
VPN_CONTROL_HYSTERIA_PORT=1935
VPN_CONTROL_VLESS_PORT=9443
VPN_CONTROL_HYS_SNI=github.com
VPN_CONTROL_REALITY_SNI=hst.andriyshkoy.ru
VPN_CONTROL_API_PORT=18010
# Production uses systemd LoadCredential for these paths.
VPN_CONTROL_TOKENS_FILE=/run/credentials/vpn-control-api.service/tokens.json
VPN_CONTROL_MARZBAN_CREDENTIALS_FILE=/run/credentials/vpn-control-api.service/marzban.json
