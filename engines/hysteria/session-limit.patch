+		}
+	}
+	f.mustConnect(t, "basic")
+}
+
+type nativeRawH3 struct {
+	conn *quic.Conn
+	h3   *http3.Transport
+}
+
+func (f *nativeFixture) rawH3(t *testing.T) *nativeRawH3 {
+	t.Helper()
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tr := &quic.Transport{Conn: pc}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	conn, err := tr.Dial(ctx, f.addr, &tls.Config{
+		InsecureSkipVerify: true, ServerName: "localhost", NextProtos: []string{http3.NextProtoH3},
+	}, &quic.Config{
+		EnableDatagrams: true, MaxDatagramFrameSize: protocol.MaxDatagramFrameSize,
+		AssumePeerMaxDatagramFrameSize: protocol.MaxDatagramFrameSize, DisablePathManager: true,
+	})
+	if err != nil {
+		_ = tr.Close()
+		_ = pc.Close()
+		t.Fatal(err)
+	}
+	h3 := &http3.Transport{Dial: func(context.Context, string, *tls.Config, *quic.Config) (*quic.Conn, error) {
+		return conn, nil
+	}}
+	t.Cleanup(func() { _ = conn.CloseWithError(0x100, ""); _ = h3.Close(); _ = tr.Close(); _ = pc.Close() })
+	return &nativeRawH3{conn: conn, h3: h3}
+}
+
+func (c *nativeRawH3) auth(key string) (int, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	req := &http.Request{
+		Method: http.MethodPost,
+		URL:    &url.URL{Scheme: "https", Host: protocol.URLHost, Path: protocol.URLPath},
+		Header: make(http.Header),
+	}
+	protocol.AuthRequestToHeader(req.Header, protocol.AuthRequest{Auth: key})
+	resp, err := c.h3.RoundTrip(req.WithContext(ctx))
+	if err != nil {
+		return 0, err
+	}
+	defer resp.Body.Close()
+	return resp.StatusCode, nil
+}
+
+func TestSessionLimitNativeDuplicateAuthDoesNotDoubleReserve(t *testing.T) {
+	f := newNativeFixture(t, &nativePolicyAuth{})
+	raw := f.rawH3(t)
+	for i := 0; i < 2; i++ {
+		if status, err := raw.auth("basic"); err != nil || status != protocol.StatusAuthOK {
+			t.Fatalf("AUTH #%d on same connection: status %d, err %v", i+1, status, err)
+		}
+	}
+	if c, err := f.connect("basic"); err == nil {
+		_ = c.Close()
+		t.Fatal("second connection admitted while duplicate-auth first remains open")
+	}
+	_ = raw.conn.CloseWithError(0x100, "")
+	f.reconnect(t, "basic")
+}
+
+func TestSessionLimitNativeAuthInFlightDisconnectDoesNotLeak(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	t.Cleanup(func() { once.Do(func() { close(release) }) })
+	var blocked atomic.Bool
+	f := newNativeFixture(t, &nativePolicyAuth{onAuth: func(key string) {
+		if key == "blocked" && blocked.CompareAndSwap(false, true) {
+			close(entered)
+			<-release
+		}
+	}})
+	raw := f.rawH3(t)
+	done := make(chan struct{})
+	go func() { defer close(done); _, _ = raw.auth("blocked") }()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("AUTH callback did not begin")
+	}
+	_ = raw.conn.CloseWithError(0x100, "disconnect during HTTP auth")
+	once.Do(func() { close(release) })
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("AUTH round trip did not finish after connection close")
+	}
+	f.reconnect(t, "basic")
+}
+
+func TestSessionLimitNativeCloseAllByAuthID(t *testing.T) {
+	f := newNativeFixture(t, &nativePolicyAuth{})
+	control, ok := f.srv.(interface{ CloseSessions([]string) int })
+	if !ok {
+		t.Fatal("server does not expose CloseSessions")
+	}
+	origin := nativeEchoOrigin(t)
+	var sameID []client.Client
+	for i := 0; i < 3; i++ {
+		sameID = append(sameID, f.mustConnect(t, "plus"))
+	}
+	other := f.mustConnect(t, "other")
+	if closed := control.CloseSessions([]string{"plus-user"}); closed != len(sameID) {
+		t.Fatalf("CloseSessions closed %d clients, want %d", closed, len(sameID))
+	}
+	for _, c := range sameID {
+		if err := nativeEcho(c, origin, []byte("revoked")); err == nil {
+			t.Error("revoked live connection still transfers TCP data")
+		}
+	}
+	if err := nativeEcho(other, origin, []byte("independent user")); err != nil {
+		t.Fatal(err)
+	}
+	if closed := control.CloseSessions([]string{"nonexistent"}); closed != 0 {
+		t.Fatalf("closing absent ID returned %d", closed)
+	}
+	// A close is not a sticky ban: durable auth revocation belongs to the caller.
+	f.reconnect(t, "plus")
+}
+
+func TestSessionLimitNativeCloseInvalidatesInFlightAuth(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	t.Cleanup(func() { once.Do(func() { close(release) }) })
+	f := newNativeFixture(t, &nativePolicyAuth{onAuth: func(key string) {
+		if key == "blocked" {
+			close(entered)
+			<-release
+		}
+	}})
+	control, ok := f.srv.(interface{ CloseSessions([]string) int })
+	if !ok {
+		t.Fatal("server does not expose CloseSessions")
+	}
+	raw := f.rawH3(t)
+	type response struct {
+		status int
+		err    error
+	}
+	done := make(chan response, 1)
+	go func() { status, err := raw.auth("blocked"); done <- response{status, err} }()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("AUTH callback did not begin")
+	}
+	control.CloseSessions([]string{"basic-user"})
+	once.Do(func() { close(release) })
+	select {
+	case result := <-done:
+		if result.err == nil && result.status == protocol.StatusAuthOK {
+			t.Fatal("stale in-flight authentication admitted after CloseSessions")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("in-flight authentication did not finish")
+	}
+	f.reconnect(t, "basic")
+}
+
+// Drop only this client's packets, without iptables, privileged networking or
+// external hosts. Closing its socket then cannot send CONNECTION_CLOSE to the
+// server, so cleanup must come from the actual QUIC idle timeout.
+type nativeDropPacketConn struct {
+	net.PacketConn
+	drop atomic.Bool
+}
+
+func (c *nativeDropPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	if c.drop.Load() {
+		return len(p), nil
+	}
+	return c.PacketConn.WriteTo(p, addr)
+}
+
+type nativeDropConnFactory struct{ conn *nativeDropPacketConn }
+
+func (f *nativeDropConnFactory) New(net.Addr) (net.PacketConn, error) {
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		return nil, err
+	}
+	f.conn = &nativeDropPacketConn{PacketConn: pc}
+	return f.conn, nil
+}
+
+func TestSessionLimitNativeLostNetworkReleasesAtIdleTimeout(t *testing.T) {
+	f := newNativeFixture(t, &nativePolicyAuth{})
+	factory := &nativeDropConnFactory{}
+	c, _, err := client.NewClient(&client.Config{
+		ConnFactory: factory, ServerAddr: f.addr, Auth: "basic",
+		TLSConfig:  client.TLSConfig{ServerName: "localhost", InsecureSkipVerify: true},
+		QUICConfig: client.QUICConfig{MaxIdleTimeout: 4 * time.Second, KeepAlivePeriod: 2 * time.Second},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = c.Close() })
+	factory.conn.drop.Store(true)
+	_ = c.Close()
+	if other, err := f.connect("basic"); err == nil {
+		_ = other.Close()
+		t.Fatal("lost-network client slot released before the server detected closure")
+	}
+	deadline := time.Now().Add(8 * time.Second)
+	for time.Now().Before(deadline) {
+		next, err := f.connect("basic")
+		if err == nil {
+			t.Cleanup(func() { _ = next.Close() })
+			if err := nativeEcho(next, nativeEchoOrigin(t), []byte("after idle timeout")); err != nil {
+				t.Fatal(err)
+			}
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	t.Fatal("lost-network slot was not released after the server's 4s QUIC idle timeout")
+}
+
+func TestSessionLimitNativeInstalledAuthenticatorCapability(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		auth      server.Authenticator
+		supported bool
+	}{
+		{"policy", &nativePolicyAuth{}, true}, {"legacy", nativeLegacyAuth{}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newNativeFixture(t, tc.auth)
+			provider, ok := f.srv.(interface{ SessionLimitSupported() bool })
+			if !ok || provider.SessionLimitSupported() != tc.supported {
+				t.Fatalf("installed authenticator capability=%v, want %v", provider, tc.supported)
+			}
+		})
+	}
+}
