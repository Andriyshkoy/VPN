+// These tests use actual native QUIC connections, AUTH requests and TCP streams.
+// They deliberately do not infer sessions from traffic counters or source IPs.
+type nativePolicyAuth struct {
+	onAuth func(string)
+}
+
+func (a *nativePolicyAuth) Authenticate(addr net.Addr, auth string, tx uint64) (bool, string) {
+	ok, id, _ := a.AuthenticateWithSessionLimit(addr, auth, tx)
+	return ok, id
+}
+
+func (a *nativePolicyAuth) AuthenticateWithSessionLimit(_ net.Addr, auth string, _ uint64) (bool, string, int) {
+	if a.onAuth != nil {
+		a.onAuth(auth)
+	}
+	switch auth {
+	case "basic", "blocked":
+		return true, "basic-user", 1
+	case "other":
+		return true, "other-user", 1
+	case "plus":
+		return true, "plus-user", 0
+	case "invalid-negative":
+		return true, "basic-user", -1
+	case "invalid-too-large":
+		return true, "basic-user", 129
+	default:
+		return false, "basic-user", 1
+	}
+}
+
+type nativeLegacyAuth struct{}
+
+func (nativeLegacyAuth) Authenticate(_ net.Addr, auth string, _ uint64) (bool, string) {
+	return auth == "legacy", "legacy-user"
+}
+
+type nativeFixture struct {
+	addr net.Addr
+	srv  server.Server
+}
+
+func nativeCertificate(t *testing.T) tls.Certificate {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "localhost"},
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
+		KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		DNSNames: []string{"localhost"}, IPAddresses: []net.IP{net.ParseIP("127.0.0.1")},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+func newNativeFixture(t *testing.T, auth server.Authenticator) *nativeFixture {
+	t.Helper()
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv, err := server.NewServer(&server.Config{
+		Conn: pc, TLSConfig: server.TLSConfig{Certificates: []tls.Certificate{nativeCertificate(t)}},
+		Authenticator: auth, DisableUDP: true,
+		QUICConfig: server.QUICConfig{MaxIdleTimeout: 4 * time.Second},
+	})
+	if err != nil {
+		_ = pc.Close()
+		t.Fatal(err)
+	}
+	done := make(chan struct{})
+	go func() { defer close(done); _ = srv.Serve() }()
+	t.Cleanup(func() {
+		_ = srv.Close()
+		select {
+		case <-done:
+		case <-time.After(3 * time.Second):
+			t.Error("server Serve did not stop")
+		}
+	})
+	return &nativeFixture{addr: pc.LocalAddr(), srv: srv}
+}
+
+func (f *nativeFixture) connect(auth string) (client.Client, error) {
+	c, _, err := client.NewClient(&client.Config{
+		ServerAddr: f.addr, Auth: auth,
+		TLSConfig:  client.TLSConfig{ServerName: "localhost", InsecureSkipVerify: true}, // ephemeral test certificate
+		QUICConfig: client.QUICConfig{MaxIdleTimeout: 4 * time.Second, KeepAlivePeriod: 2 * time.Second},
+	})
+	return c, err
+}
+
+func (f *nativeFixture) mustConnect(t *testing.T, auth string) client.Client {
+	t.Helper()
+	c, err := f.connect(auth)
+	if err != nil {
+		t.Fatalf("connect %q: %v", auth, err)
+	}
+	t.Cleanup(func() { _ = c.Close() })
+	return c
+}
+
+func (f *nativeFixture) reconnect(t *testing.T, auth string) client.Client {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	var lastErr error
+	for time.Now().Before(deadline) {
+		c, err := f.connect(auth)
+		if err == nil {
+			t.Cleanup(func() { _ = c.Close() })
+			return c
+		}
+		lastErr = err
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("slot not released for %q: %v", auth, lastErr)
+	return nil
+}
+
+func nativeEchoOrigin(t *testing.T) string {
+	t.Helper()
