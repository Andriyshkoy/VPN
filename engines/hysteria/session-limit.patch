+package trafficlogger
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+type testController struct {
+	ids         []string
+	unsupported bool
+}
+
+func (c *testController) SessionLimitSupported() bool { return !c.unsupported }
+
+func (c *testController) CloseSessions(ids []string) int { c.ids = ids; return 3 }
+
+func TestSessionCapabilitiesRequireControllerAndSecret(t *testing.T) {
+	for _, tc := range []struct {
+		secret, auth string
+		attached     bool
+		status       int
+	}{
+		{"", "", true, 503}, {"s", "", true, 401}, {"s", "wrong", true, 401}, {"s", "s", false, 503}, {"s", "s", true, 200},
+	} {
+		s := NewTrafficStatsServer(tc.secret).(*trafficStatsServerImpl)
+		if tc.attached {
+			s.SetSessionController(&testController{})
+		}
+		req := httptest.NewRequest("GET", "/capabilities", nil)
+		req.Header.Set("Authorization", tc.auth)
+		w := httptest.NewRecorder()
+		s.ServeHTTP(w, req)
+		if w.Code != tc.status {
+			t.Fatalf("%+v: status=%d", tc, w.Code)
+		}
+		if w.Code == 200 {
+			var got map[string]any
+			_ = json.Unmarshal(w.Body.Bytes(), &got)
+			if got["max_sessions"] != true || got["close_by_auth_id"] != true || got["session_scope"] != "auth_id_per_server_instance" {
+				t.Fatalf("%v", got)
+			}
+		}
+	}
+}
+
+func TestSessionCloseControl(t *testing.T) {
+	for _, body := range []string{`null`, `[]`, `[""]`, `{}`, `["u"] {}`, `[true]`} {
+		s := NewTrafficStatsServer("s").(*trafficStatsServerImpl)
+		c := &testController{}
+		s.SetSessionController(c)
+		req := httptest.NewRequest("POST", "/close", strings.NewReader(body))
+		req.Header.Set("Authorization", "s")
+		w := httptest.NewRecorder()
+		s.ServeHTTP(w, req)
+		if w.Code != http.StatusBadRequest || c.ids != nil {
+			t.Fatalf("body=%s status=%d calls=%v", body, w.Code, c.ids)
+		}
+	}
+	s := NewTrafficStatsServer("s").(*trafficStatsServerImpl)
+	c := &testController{}
+	s.SetSessionController(c)
+	req := httptest.NewRequest("POST", "/close", strings.NewReader(`["u","v"]`))
+	req.Header.Set("Authorization", "s")
+	w := httptest.NewRecorder()
+	s.ServeHTTP(w, req)
+	if w.Code != 200 || len(c.ids) != 2 || strings.TrimSpace(w.Body.String()) != `{"closed":3}` {
+		t.Fatalf("%d %s %v", w.Code, w.Body.String(), c.ids)
+	}
+}
