+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ln.Close() })
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() { defer c.Close(); _, _ = io.Copy(c, c) }()
+		}
+	}()
+	return ln.Addr().String()
+}
+
+func nativeEcho(c client.Client, addr string, payload []byte) error {
+	stream, err := c.TCP(addr)
+	if err != nil {
+		return err
+	}
+	defer stream.Close()
+	_ = stream.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err := stream.Write(payload); err != nil {
+		return err
+	}
+	got := make([]byte, len(payload))
+	if _, err := io.ReadFull(stream, got); err != nil {
+		return err
+	}
+	if !bytes.Equal(got, payload) {
+		return fmt.Errorf("echo differs: got %q, want %q", got, payload)
+	}
+	return nil
+}
+
+func TestSessionLimitNativeFirstWinsStreamsAndReconnect(t *testing.T) {
+	f := newNativeFixture(t, &nativePolicyAuth{})
+	origin := nativeEchoOrigin(t)
+	first := f.mustConnect(t, "basic")
+	if second, err := f.connect("basic"); err == nil {
+		_ = second.Close()
+		t.Fatal("second client with max_sessions=1 was admitted")
+	}
+	other := f.mustConnect(t, "other")
+	if err := nativeEcho(other, origin, []byte("other user remains independent")); err != nil {
+		t.Fatal(err)
+	}
+	const streams = 12
+	errs := make(chan error, streams)
+	for i := 0; i < streams; i++ {
+		go func(i int) { errs <- nativeEcho(first, origin, []byte(fmt.Sprintf("parallel stream %d", i))) }(i)
+	}
+	for i := 0; i < streams; i++ {
+		if err := <-errs; err != nil {
+			t.Fatalf("first client's concurrent TCP stream: %v", err)
+		}
+	}
+	_ = first.Close()
+	_ = first.Close() // repeated cleanup must not release another client's slot
+	reconnected := f.reconnect(t, "basic")
+	if err := nativeEcho(reconnected, origin, []byte("reconnected")); err != nil {
+		t.Fatal(err)
+	}
+	if extra, err := f.connect("basic"); err == nil {
+		_ = extra.Close()
+		t.Fatal("duplicate release allowed a second live client")
+	}
+}
+
+func TestSessionLimitNativeUnlimitedAndLegacyCompatibility(t *testing.T) {
